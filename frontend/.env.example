# Copia questo file in ".env" per sviluppo locale (default gia' corretto).
# In produzione (dietro Caddy sullo stesso dominio) si builda con
# VITE_API_BASE_URL=/api: Caddy toglie il prefisso "/api" e gira le richieste
# al backend, che infatti non lo usa nelle sue rotte (vedi DEPLOY.md).
VITE_API_BASE_URL=http://127.0.0.1:8001
